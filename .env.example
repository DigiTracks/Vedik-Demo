# Public site origin.
#
# Used to build every absolute URL in the site: metadataBase, canonical tags,
# Open Graph / Twitter image URLs, sitemap.xml entries, robots.txt and the
# JSON-LD structured data.
#
# This MUST be set in Vercel (Project Settings > Environment Variables), applied
# to all three environments, or the deployed site will advertise
# http://localhost:3000 as its canonical origin.
#
# If the site is served from a sub-path, include it here, e.g.
# https://example.com/vedik
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed if the demo is served from a sub-path rather than a domain root.
# Kept in sync with SITE_URL above; see next.config.ts.
# NEXT_PUBLIC_BASE_PATH=
